    {
      "parameters": {
        "jsCode": "const cmd = $('Analizar comando').first().json;\nconst filas = $input.all().map(i => i.json).filter(f => f.id_tutoria);\nconst activas = filas.filter(f => ['Solicitada', 'Asignada', 'Confirmada'].includes(f.estado));\n\nif (!cmd.id_tutoria) {\n  if (!activas.length) {\n    return [{ json: { accion: 'mensaje', chat_id: cmd.chat_id, texto: 'No tienes tutorías para cancelar.' } }];\n  }\n  const lista = activas.map(f => `• ${f.id_tutoria}: ${f.materia} — ${f.fecha} ${f.hora} (${f.estado})`).join('\\n');\n  return [{ json: { accion: 'mensaje', chat_id: cmd.chat_id,\n    texto: '¿Cuál quieres cancelar? Escribe /cancelar y el código, por ejemplo: /cancelar ' + activas[0].id_tutoria + '\\n\\n' + lista } }];\n}\n\nconst t = activas.find(f => f.id_tutoria === cmd.id_tutoria);\nif (!t) {\n  return [{ json: { accion: 'mensaje', chat_id: cmd.chat_id, texto: 'No encontré una tutoría activa tuya con el código ' + cmd.id_tutoria + '.' } }];\n}\n\nconst dias = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];\nconst [y, m, d] = String(t.fecha).split('-').map(Number);\nconst dia = dias[new Date(y, m - 1, d).getDay()];\n\nreturn [{ json: { accion: 'cancelar', chat_id: cmd.chat_id, id_tutoria: t.id_tutoria,\n  id_tutor: t.id_tutor, dia_semana: dia, hora: t.hora, materia: t.materia, fecha: t.fecha } }];"
      },
